#!/bin/sh
# Git pre-commit hook: Executa a checagem de tipos e compilação antes do commit

echo "========================================================"
echo "⚡ [PRE-COMMIT] Validando TypeScript e Build do Front-end..."
echo "========================================================"

npm run build
BUILD_EXIT_CODE=$?

if [ $BUILD_EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [PRE-COMMIT BLOQUEADO] Erro na compilação do front-end!"
    echo "Corrija os erros de TypeScript/Build antes de commitar ou use 'git commit --no-verify'."
    echo "========================================================"
    exit 1
fi

echo "✅ [PRE-COMMIT APROVADO] Build do front-end passou com sucesso!"
echo "========================================================"
exit 0
